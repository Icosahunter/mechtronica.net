<!DOCTYPE html>

<html lang="en">
  <head>
    <!-- Meta tags -->
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0" name="viewport" />
    <meta name="viewport" content="width=device-width" />

    <!-- Favicon and title -->
    <link rel="icon" href="{{site.url}}/images/icon.svg">
    <title> {{ title }} </title>

    <!-- Condensate CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@icosahunter/condensate@1.0.1-beta/dist/condensate.min.css">

    <!-- Custom Condensate Variables -->
    <link href="{{site.url}}/custom-variables.css" rel="stylesheet" />

    <!-- Google Material Icons -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

    <style>
        .main-content > :is(h1, h2, h3, h4, h5, h6, p):first-child {
         margin-top: 3em;
        }
    </style>

    <!-- Google Fonts -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Jost">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Inconsolata">

  </head>
  <body class="hbox fullscreen">
    <!-- Modals go here -->
    <!-- Reference: https://www.gethalfmoon.com/docs/modal -->

    <!--<div class="modal" id="modal-1" tabindex="-1" role="dialog">
      <div class="modal-dialog" role="document">
        <div class="modal-content modal-content-media">
          <a href="#" class="close" role="button" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </a>
          <h5 class="modal-title" id="modal-title"></h5>
          <div id="modal-content"></div>
        </div>
      </div>
    </div>-->

      <details class="sidebar">
          <summary class="button sidebar-button"></summary>
              <div class="vbox padding" style="height:100vh; overflow-y: scroll;">
                <a href="#" class="">
                <img class="height-font-xl" src="{{site.url}}/images/logo-beta.svg" alt="Mechtronica">
                </a>
                <br/>

                {% for k1, v1 in navlinks %}
                {% if v1 is string %}
                    <a href="{{site.url}}{{v1}}" class="{{ " active" if page.url == v1 }}">{{ k1 }}</a>
                {% else %}
                    <details class="vbox" {{ " open" if page.url in v1 | dump }}>
                        <summary>
                            {{ k1 }}
                        </summary>
                        <div class="vbox">
                            {% for k2, v2 in v1 %}
                            {% if v2 is string %}
                                <a href="{{site.url}}{{v2}}" class="margin-left {{ " active" if page.url == v2 }}">{{ k2 }}</a>
                            {% else %}
                                <h6>{{ k2 }}</h6>
                                {% for k3, v3 in v2 %}
                                <a href="{{site.url}}{{v3}}" class="margin-left {{ " active" if page.url == v3 }}">{{ k3 }}</a>
                                {% endfor %}
                            {% endif %}
                            {% endfor %}
                        </div>
                    </details>
                {% endif %}
                {% endfor %}
                <div class="hbox center">
                <a class="dm-hidden" style="color: #000;" href="mailto:feedback@mechtronica.net"><span class="material-symbols-outlined height-font-lg"> mail </span></a>
                <a class="lm-hidden" style="color: #fff;" href="mailto:feedback@mechtronica.net"><span class="material-symbols-outlined height-font-lg"> mail </span></a>
                <a class="dm-hidden" href="https://github.com/mechtronica/mechtronica.net/issues"><img class="height-font-lg" src="{{site.url}}/images/github-mark.svg"/></a>
                <a class="lm-hidden" href="https://github.com/mechtronica/mechtronica.net/issues"><img class="height-font-lg" src="{{site.url}}/images/github-mark-white.svg"/></a>
                <a class="dm-hidden" href="https://discord.gg/VPzzYHqxFy"><img class="height-font-lg" src="{{site.url}}/images/discord-mark-black.svg"/></a>
                <a class="lm-hidden" href="https://discord.gg/VPzzYHqxFy"><img class="height-font-lg" src="{{site.url}}/images/discord-mark-white.svg"/></a>
                </div>
                <p class="center font-sm"> The website is licensed under <br> <a class="font-sm" href="https://creativecommons.org/licenses/by-sa/4.0/legalcode"> Creative Commons CC BY-SA </a></p>
            </div>
      </details>

      <main class="vbox width-full">
        <div class="vbox padding scroll-y width-xl center main-content">
          {{ content | safe }}
        </div>
        <div class="spacer"></div>
        <footer class="background-color">
          <p class="text-center font-sm"> Have questions? <br> <a class="font-sm" href="https://discord.gg/VPzzYHqxFy"> Join our Discord </a> and ask away! </p>
        </footer>
      </main>
  </body>
</html>
